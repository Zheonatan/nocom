{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    // `tsc -b` grava o estado incremental mesmo com `noEmit`; sem este campo o
    // .tsbuildinfo cai na raiz do repositório.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // Os testes rodam por type stripping (`node --test`, sem transpilar): esta
    // flag proíbe em compilação exatamente as sintaxes que o Node não consegue
    // apagar (enum, namespace, parameter properties) — sem ela, a primeira
    // enum num módulo testado viraria erro de runtime só na suite.
    "erasableSyntaxOnly": true,
    // Acesso por índice devolve `T | undefined`: é a strict flag que faltava
    // com retorno real em `dates.ts`/`recurrence.ts`, que vivem de índice.
    "noUncheckedIndexedAccess": true,

    /* shadcn/ui: alias @ -> src */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
